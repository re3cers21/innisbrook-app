CREATE TABLE public.Players (
  draft_pick bigint,
  is_captain boolean,
  player_id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  name text NOT NULL,
  handicap_index real NOT NULL,
  team text NOT NULL,
  CONSTRAINT Players_pkey PRIMARY KEY (player_id)
);
CREATE TABLE public.Rounds (
  course_id bigint NOT NULL,
  tee_id bigint NOT NULL,
  round_number integer NOT NULL,
  round_date date,
  round_id bigint NOT NULL DEFAULT nextval('rounds_round_id_seq'::regclass),
  CONSTRAINT Rounds_pkey PRIMARY KEY (round_id),
  CONSTRAINT rounds_tee_id_fkey FOREIGN KEY (tee_id) REFERENCES public.Tees(tee_id),
  CONSTRAINT rounds_course_id_fkey FOREIGN KEY (course_id) REFERENCES public.Courses(course_id)
);
CREATE TABLE public.Scores (
  round_id bigint NOT NULL,
  player_id bigint NOT NULL,
  hole_id bigint NOT NULL,
  gross_strokes integer NOT NULL,
  net_strokes integer,
  hole_result text,
  score_id bigint NOT NULL DEFAULT nextval('scores_score_id_seq1'::regclass),
