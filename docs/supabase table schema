  CONSTRAINT scores_round_id_fkey1 FOREIGN KEY (round_id) REFERENCES public.Rounds(round_id)
);
CREATE TABLE public.Tees (
  course_id bigint NOT NULL,
  tee_name text NOT NULL,
  tee_par bigint NOT NULL,
  tee_yardage bigint NOT NULL,
  tee_id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  tee_rating numeric NOT NULL,
  tee_slope bigint NOT NULL,
