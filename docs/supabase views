create view public.detailed_scores as
with
  course_handicaps as (
    select distinct
      s_1.round_id,
      s_1.player_id,
      round(
        p.handicap_index * (t.tee_slope::numeric / 113::numeric)::double precision + (t.tee_rating - t.tee_par::numeric)::double precision
      ) as course_handicap
    from
      "Scores" s_1
      join "Players" p on s_1.player_id = p.player_id
      join "Rounds" r on s_1.round_id = r.round_id
      join "Tees" t on r.tee_id = t.tee_id
  )
select
  s.score_id,
  s.round_id,
  s.player_id,
  s.hole_id,
  s.gross_strokes,
  s.gross_strokes::double precision - (
    floor(ch.course_handicap / 18::double precision) + case
      when h.hole_handicap <= (ch.course_handicap::integer % 18) then 1
      else 0
    end::double precision
  ) as net_strokes
from
  "Scores" s
  join course_handicaps ch on s.round_id = ch.round_id
  and s.player_id = ch.player_id
  join "Holes" h on s.hole_id = h.hole_id;


create view public.player_round_net_scores as
select
  p.player_id,
  p.name as player_name,
  r.round_id,
  r.round_date,
  c.course_name,
  sum(s.net_strokes) as total_net_score
from
  "Scores" s
  join "Players" p on s.player_id = p.player_id
  join "Rounds" r on s.round_id = r.round_id
  join "Courses" c on r.course_id = c.course_id
group by
  p.player_id,
  r.round_id,
  c.course_name
order by
  r.round_date desc,
  (sum(s.net_strokes));

  create view public.course_handicap_view as
select
  p.player_id,
  p.name as player_name,
  t.tee_id,
  t.tee_name,
  c.course_id,
  c.course_name,
  round(
    p.handicap_index * (t.tee_slope::numeric / 113::numeric)::double precision + (t.tee_rating - t.tee_par::numeric)::double precision
  ) as course_handicap
from
  "Players" p
  cross join "Tees" t
  join "Courses" c on t.course_id = c.course_id;


  create view public.recent_rounds_view as
select
  r.round_id,
  r.round_date,
  p.player_id,
  p.name as player_name,
  c.course_id,
  c.course_name,
  t.tee_name,
  sum(s.gross_strokes) as total_score,
  c.total_par
from
  "Rounds" r
  join "Scores" s on r.round_id = s.round_id
  join "Players" p on s.player_id = p.player_id
  join "Courses" c on r.course_id = c.course_id
  join "Tees" t on r.tee_id = t.tee_id
group by
  r.round_id,
  p.player_id,
  c.course_id,
  t.tee_id
order by
  r.round_date desc
limit
  10;


  create view public.hilo_results_round1 as
with
  match_players as (
    select
      m.match_number,
      m.team,
      m.player_id
    from
      hilo_matchups m
    where
      m.round_id = 1
  ),
  scores as (
    select
      s.player_id,
      s.hole_id,
      s.net_strokes
    from
      detailed_scores s
    where
      s.round_id = 1
  ),
  match_scores as (
    select
      mp.match_number,
      mp.team,
      s.hole_id,
      s.player_id,
      s.net_strokes
    from
      match_players mp
      join scores s on mp.player_id = s.player_id
  ),
  team_hilo as (
    select
      match_scores.match_number,
      match_scores.hole_id,
      match_scores.team,
      min(match_scores.net_strokes) as low_net,
      max(match_scores.net_strokes) as high_net
    from
      match_scores
    group by
      match_scores.match_number,
      match_scores.hole_id,
      match_scores.team
  ),
  hole_results as (
    select
      t1.match_number,
      t1.hole_id,
      t1.team as team1,
      t2.team as team2,
      t1.low_net as team1_low,
      t1.high_net as team1_high,
      t2.low_net as team2_low,
      t2.high_net as team2_high,
      case
        when t1.low_net < t2.low_net
        and t1.high_net <= t2.high_net
        or t1.low_net <= t2.low_net
        and t1.high_net < t2.high_net then 1::numeric
        else 0::numeric
      end as team1_hole_result,
      case
        when t2.low_net < t1.low_net
        and t2.high_net <= t1.high_net
        or t2.low_net <= t1.low_net
        and t2.high_net < t1.high_net then 1::numeric
        else 0::numeric
      end as team2_hole_result
    from
      team_hilo t1
      join team_hilo t2 on t1.match_number = t2.match_number
      and t1.hole_id = t2.hole_id
      and t1.team <> t2.team
    where
      t1.team = 'Kinnaird'::text
  ),
  running_score as (
    select
      hole_results.match_number,
      hole_results.hole_id,
      hole_results.team1,
      hole_results.team2,
      hole_results.team1_low,
      hole_results.team1_high,
      hole_results.team2_low,
      hole_results.team2_high,
      hole_results.team1_hole_result,
      hole_results.team2_hole_result,
      sum(
        hole_results.team1_hole_result - hole_results.team2_hole_result
      ) over (
        partition by
          hole_results.match_number
        order by
          hole_results.hole_id
      ) as team1_running,
      sum(
        hole_results.team2_hole_result - hole_results.team1_hole_result
      ) over (
        partition by
          hole_results.match_number
        order by
          hole_results.hole_id
      ) as team2_running
    from
      hole_results
  )
select
  match_number,
  hole_id,
  team1,
  team2,
  team1_low,
  team1_high,
  team2_low,
  team2_high,
  team1_hole_result,
  team2_hole_result,
  team1_running,
  team2_running
from
  running_score
order by
  match_number,
  hole_id;


  create view public.singles_results_round3 as
with
  matchups as (
    select * from singles_matchups where round_id = 3
  ),
  scores as (
    select s.player_id, s.hole_id, s.net_strokes
    from detailed_scores s
    where s.round_id = 3
  ),
  match_scores as (
    select
      m.match_number,
      m.player1_id,
      m.player2_id,
      m.team1,
      m.team2,
      s1.hole_id,
      s1.net_strokes as player1_net,
      s2.net_strokes as player2_net
    from matchups m
    join scores s1 on m.player1_id = s1.player_id
    join scores s2 on m.player2_id = s2.player_id and s1.hole_id = s2.hole_id
  ),
  hole_results as (
    select
      match_number,
      hole_id,
      player1_id,
      player2_id,
      team1,
      team2,
      player1_net,
      player2_net,
      case
        when player1_net < player2_net then 1
        when player2_net < player1_net then -1
        else 0
      end as hole_result
    from match_scores
  ),
  running_score as (
    select *,
      sum(hole_result) over (partition by match_number order by hole_id) as running
    from hole_results
  )
select * from running_score
order by match_number, hole_id;


-- Create a view for Round 5 team net totals
create or replace view team_net_totals_round5 as
select
  p.team,
  sum(ds.net_strokes) as team_net_total
from
  detailed_scores ds
  join Players p on ds.player_id = p.player_id
where
  ds.round_id = 5
group by
  p.team;



 create or replace view gross_leaderboard_detailed as
with round_pars as (
  select r.round_id, c.total_par
  from "Rounds" r
  join "Courses" c on r.course_id = c.course_id
  where r.round_id in (1,2,3,4,5)
),
player_gross as (
  select
    p.player_id,
    p.name,
    sum(case when s.round_id = 1 then s.gross_strokes else 0 end) as gross_r1,
    sum(case when s.round_id = 2 then s.gross_strokes else 0 end) as gross_r2,
    sum(case when s.round_id = 3 then s.gross_strokes else 0 end) as gross_r3,
    sum(case when s.round_id = 4 then s.gross_strokes else 0 end) as gross_r4,
    sum(case when s.round_id = 5 then s.gross_strokes else 0 end) as gross_r5,
    sum(s.gross_strokes) as total_gross
  from
    "Scores" s
    join "Players" p on s.player_id = p.player_id
  where
    s.round_id in (1,2,3,4,5)
  group by
    p.player_id, p.name
)
select
  pg.player_id,
  pg.name,
  pg.gross_r1,
  pg.gross_r2,
  pg.gross_r3,
  pg.gross_r4,
  pg.gross_r5,
  rp1.total_par as par_r1,
  rp2.total_par as par_r2,
  rp3.total_par as par_r3,
  rp4.total_par as par_r4,
  rp5.total_par as par_r5,
  (pg.gross_r1 - rp1.total_par) as to_par_r1,
  (pg.gross_r2 - rp2.total_par) as to_par_r2,
  (pg.gross_r3 - rp3.total_par) as to_par_r3,
  (pg.gross_r4 - rp4.total_par) as to_par_r4,
  (pg.gross_r5 - rp5.total_par) as to_par_r5,
  pg.total_gross,
  (coalesce(pg.gross_r1,0) + coalesce(pg.gross_r2,0) + coalesce(pg.gross_r3,0) + coalesce(pg.gross_r4,0) + coalesce(pg.gross_r5,0))
    - (coalesce(rp1.total_par,0) + coalesce(rp2.total_par,0) + coalesce(rp3.total_par,0) + coalesce(rp4.total_par,0) + coalesce(rp5.total_par,0))
    as total_to_par
from
  player_gross pg
  left join round_pars rp1 on rp1.round_id = 1
  left join round_pars rp2 on rp2.round_id = 2
  left join round_pars rp3 on rp3.round_id = 3
  left join round_pars rp4 on rp4.round_id = 4
  left join round_pars rp5 on rp5.round_id = 5
order by
  pg.total_gross asc;